
# ============================================================
# OpenBB Platform + Sentriq Environment Configuration
# ============================================================
# Update these with your actual API keys before running

# --- AI/ML APIs ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key


# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Financial Data APIs ---
# Get from: https://fred.stlouisfed.org/docs/api/
FRED_API_KEY=your-fred-api-key

# Get from: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=your-tiingo-api-key

# Get from: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Get from: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your-fmp-api-key

# Get from: https://www.openfigi.com/api (free; raises ISIN→FIGI rate limit
# from 25 req / 6s to 250 req / 6s). Used by Omnisearch /api/omni/symbology.
OPENFIGI_API_KEY=

# UCITS / mutual fund provider for /api/omni/lookup/by-isin/{isin}.
# Leave unset for yfinance-only coverage (good but with gaps). To enable
# paid coverage set FUNDS_PROVIDER=fundslibrary|fefundinfo|morningstar
# and FUNDS_API_KEY=<your-key>. No client implementation yet — slot only.
FUNDS_PROVIDER=
FUNDS_API_KEY=

# ESG ratings provider for /api/omni/asset/{symbol}/esg. Yahoo no longer
# reliably exposes ESG; set ESG_PROVIDER=msci|sustainalytics|refinitiv
# and ESG_API_KEY=<your-key>. Without configuration the endpoint falls
# back to yfinance.sustainability (best-effort) and finally a
# provider_required marker. No client implementation yet — slot only.
ESG_PROVIDER=
ESG_API_KEY=

# --- FastAPI Configuration ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true
FASTAPI_RELOAD=true

# --- Streamlit Configuration ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_LOGGER_LEVEL=debug

# --- Frontend Configuration ---
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
API_TIMEOUT=30

# --- Database (Optional) ---
# For PostgreSQL use: postgresql://user:password@localhost/dbname
# For SQLite use: sqlite:///./trading.db
DATABASE_URL=sqlite:///./trading.db

# --- Feature Flags ---
DEBUG_MODE=true
ENABLE_AI_INSIGHTS=true
ENABLE_TRADING_ENGINE=true
ENABLE_STREAMLIT=true
ENABLE_FASTAPI=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Security (Generate random string for production) ---
SECRET_KEY=your-development-secret-do-not-use-in-production-generate-random

# --- CORS Settings ---
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://localhost:8501"]
CORS_ALLOW_CREDENTIALS=true
